  "color": {
   "background": "var(--wp--preset--color--zof-paper)",
   "text": "var(--wp--preset--color--zof-ink)"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family--body)",
   "lineHeight": "1.65"
  },
  "elements": {
   "heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family--display)",
     "fontWeight": "600",
     "lineHeight": "1.15"
    },
    "color": {
     "text": "var(--wp--preset--color--zof-green-dark)"
    }
   },
   "link": {
    "color": {
     "text": "var(--wp--preset--color--zof-green)"
    }
   },
   "button": {
    "color": {
     "background": "var(--wp--preset--color--zof-green)",
     "text": "#ffffff"
    },
    "border": {
     "radius": "999px"
    },
    "typography": {
     "fontWeight": "600"
    }
   }
  }
